# Maintainer: Abraham Ukachi <abrahamukachi@users.noreply.github.com>

pkgname=omadroid
pkgver=0.2.0
pkgrel=1
pkgdesc="A dead-simple Android phone for Omarchy, one version per key"
arch=('x86_64')
url="https://github.com/abraham-ukachi/omadroid"
license=('MIT')
depends=('waydroid' 'curl' 'unzip' 'hicolor-icon-theme')
# The toolchain is rustup's, so there is no distro rust package to ask for.
makedepends=()
source=("$pkgname::git+file://$startdir/..")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname"
    cargo build --release --locked -p omadroid
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 target/release/omadroid "$pkgdir/usr/bin/omadroid"
    install -Dm644 pkgbuild/omadroid.desktop \
        "$pkgdir/usr/share/applications/omadroid.desktop"
    install -Dm644 pkgbuild/omadroid.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/omadroid.svg"
}
