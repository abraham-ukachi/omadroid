import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import "fonts/iAWriterMonoS-Regular.ttf";

export { Theme }

export struct VersionRow {
    id: string,
    title: string,
    subtitle: string,
    state: string,
    live: bool,
    download: bool,
}

// One line of the key sheet: the key, then what it does.
component KeyRow inherits Rectangle {
    height: 24px;
    background: transparent;
    in property <string> k: "";
    in property <string> v: "";

    HorizontalLayout {
        spacing: 14px;
        Text {
            width: 104px;
            text: root.k;
            color: Theme.accent;
            font-size: 11px;
            vertical-alignment: center;
        }
        Text {
            text: root.v;
            color: Theme.fg;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// A tab of the settings pane.
component Tab inherits Rectangle {
    width: 78px;
    height: 26px;
    border-radius: Theme.radius * 1px;
    background: root.chosen ? Theme.panel : transparent;
    border-width: 1px;
    border-color: root.chosen ? Theme.accent : Theme.border;
    in property <string> label: "";
    in property <bool> chosen: false;
    callback pick();

    Text {
        text: root.label;
        color: root.chosen ? Theme.accent : Theme.muted;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => {
            root.pick();
        }
    }
}

// The settings icon: three sliders. Drawn, because a font is a bad place to
// keep an icon you depend on.
component Sliders inherits Rectangle {
    width: 30px;
    height: 30px;
    border-radius: Theme.radius * 1px;
    background: hit.has-hover ? Theme.panel : transparent;
    border-width: 1px;
    border-color: root.marked ? Theme.accent : Theme.border;
    in property <bool> marked: false;
    callback pick();

    Rectangle { x: 8px; y: 9px; width: 14px; height: 1px; background: Theme.muted; }
    Rectangle { x: 8px; y: 15px; width: 14px; height: 1px; background: Theme.muted; }
    Rectangle { x: 8px; y: 21px; width: 14px; height: 1px; background: Theme.muted; }

    Rectangle { x: 10px; y: 7px; width: 4px; height: 4px; border-radius: 2px; background: root.marked ? Theme.accent : Theme.fg; }
    Rectangle { x: 15px; y: 13px; width: 4px; height: 4px; border-radius: 2px; background: root.marked ? Theme.accent : Theme.fg; }
    Rectangle { x: 12px; y: 19px; width: 4px; height: 4px; border-radius: 2px; background: root.marked ? Theme.accent : Theme.fg; }

    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.pick();
        }
    }
}

// The fullscreen icon: the four corners of a frame. Drawn for the same reason
// the sliders are.
component Expand inherits Rectangle {
    width: 30px;
    height: 30px;
    border-radius: Theme.radius * 1px;
    background: hit.has-hover ? Theme.panel : transparent;
    border-width: 1px;
    border-color: root.marked ? Theme.accent : Theme.border;
    in property <bool> marked: false;
    callback pick();

    property <color> ink: root.marked ? Theme.accent : Theme.fg;

    // Top left
    Rectangle { x: 10px; y: 10px; width: 5px; height: 1px; background: ink; }
    Rectangle { x: 10px; y: 10px; width: 1px; height: 5px; background: ink; }
    // Top right
    Rectangle { x: 15px; y: 10px; width: 5px; height: 1px; background: ink; }
    Rectangle { x: 19px; y: 10px; width: 1px; height: 5px; background: ink; }
    // Bottom left
    Rectangle { x: 10px; y: 19px; width: 5px; height: 1px; background: ink; }
    Rectangle { x: 10px; y: 15px; width: 1px; height: 5px; background: ink; }
    // Bottom right
    Rectangle { x: 15px; y: 19px; width: 5px; height: 1px; background: ink; }
    Rectangle { x: 19px; y: 15px; width: 1px; height: 5px; background: ink; }

    hit := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.pick();
        }
    }
}

// One window, one job: pick the Android version, and it is on the desktop.
export component AppWindow inherits Window {
    title: "omadroid";
    preferred-width: 800px;
    preferred-height: 880px;
    min-width: 660px;
    min-height: 600px;
    background: Theme.bg;
    default-font-family: "iA Writer Mono S";
    default-font-size: 13px;

    in property <[VersionRow]> rows;
    in-out property <int> selected: 0;
    in property <string> caption: "";
    in property <string> status-text: "starting";
    in property <string> engine-text: "";
    in property <string> app-version: "";
    in property <string> notice: "";
    in property <string> setup-detail: "";
    in property <bool> running: false;
    in property <bool> busy: false;
    in property <bool> needs-setup: false;
    in property <float> progress: 0;
    in-out property <bool> settings: false;
    in-out property <int> tab: 0;
    // The phone on the whole screen: the bar stays, because it is the way back.
    in-out property <bool> wide: false;

    // Read back by the app, so Hyprland can put Android on the panel.
    in-out property <length> phone-x: 0px;
    in-out property <length> phone-y: 0px;
    in-out property <length> phone-w: 0px;
    in-out property <length> phone-h: 0px;

    // The phone fills the window vertically, but a phone is a phone: it stops
    // growing at 780px, which is the height of a real one on a desk. Rust sizes
    // it from the window, because a layout cannot measure itself without
    // looping.
    in-out property <length> panel-w: 330px;
    in-out property <length> panel-h: 700px;

    callback refresh();
    callback launch(string);
    callback stop();
    callback install(string);
    callback remove(string);
    callback show-ui();
    callback setup();
    callback quit();

    // Space (or S) starts the selected version, which is the whole point.
    public function primary() -> bool {
        if (root.rows.length == 0) {
            return false;
        }
        root.launch(root.rows[root.selected].id);
        return true;
    }

    public function act(key: string) -> bool {
        if (key == "j") {
            if (root.selected + 1 < root.rows.length) {
                root.selected = root.selected + 1;
            }
            return true;
        }
        if (key == "k") {
            if (root.selected > 0) {
                root.selected = root.selected - 1;
            }
            return true;
        }
        if (key == " " || key == "s") {
            return root.primary();
        }
        if (key == "d") {
            if (root.rows.length > 0) {
                root.install(root.rows[root.selected].id);
            }
            return true;
        }
        if (key == "x") {
            root.stop();
            return true;
        }
        if (key == "r") {
            if (root.rows.length > 0) {
                root.remove(root.rows[root.selected].id);
            }
            return true;
        }
        if (key == "o") {
            root.show-ui();
            return true;
        }
        if (key == "R") {
            root.refresh();
            return true;
        }
        if (key == "," || key == "?") {
            root.settings = !root.settings;
            root.tab = key == "?" ? 1 : 0;
            return true;
        }
        if (key == "f") {
            root.wide = !root.wide;
            return true;
        }
        if (key == "q") {
            root.quit();
            return true;
        }
        return false;
    }

    // The keyboard is the app: the FocusScope takes every key the window gets.
    keys := FocusScope {
        width: 100%;
        height: 100%;

        init => {
            keys.focus();
        }

        key-pressed(event) => {
            // Escape arrives by name on some runs and as the raw control
            // character on others.
            if (event.text == "Escape" || event.text == "\u{1b}") {
                if (root.wide) {
                    root.wide = false;
                    return accept;
                }
                if (root.settings) {
                    root.settings = false;
                    return accept;
                }
            }
            if (root.act(event.text)) {
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.bg;

            VerticalLayout {
                spacing: 0px;

                // The app bar: name, the version and state under it, fullscreen
                // and settings. It is slimmer when the phone has the screen.
                Rectangle {
                    height: root.wide ? 44px : 64px;
                    background: Theme.bg;

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 14px;
                        spacing: 12px;
                        alignment: start;

                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: "omadroid";
                                color: Theme.fg;
                                font-size: 16px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            Text {
                                text: root.caption;
                                color: root.running ? Theme.accent : Theme.muted;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }

                        VerticalLayout {
                            width: 30px;
                            alignment: center;

                            Expand {
                                marked: root.wide;
                                pick => {
                                    root.wide = !root.wide;
                                }
                            }
                        }

                        VerticalLayout {
                            width: 30px;
                            alignment: center;

                            Sliders {
                                marked: root.settings;
                                pick => {
                                    root.settings = !root.settings;
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                // The phone, and the versions (or the settings) beside it.
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 14px;
                    padding-bottom: 12px;
                    spacing: 18px;
                    vertical-stretch: 1;

                    VerticalLayout {
                        width: root.panel-w;
                        spacing: 8px;
                        alignment: start;

                        phone := Rectangle {
                            width: 100%;
                            height: root.panel-h;
                            border-radius: Theme.radius * 1px;
                            background: Theme.key;
                            border-width: 2px;
                            border-color: root.running ? Theme.accent : Theme.border;
                            clip: true;

                            // What is here when Android is not on the panel yet.
                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;

                                Text {
                                    text: root.running ? "android" : "not running";
                                    color: root.running ? Theme.accent : Theme.muted;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                }

                                VerticalLayout {
                                    spacing: 8px;

                                    for band in 5 : HorizontalLayout {
                                        spacing: 8px;

                                        for tile in 4 : Rectangle {
                                            height: 30px;
                                            border-radius: Theme.radius * 1px;
                                            background: root.running ? Theme.panel : Theme.key;
                                            border-width: 1px;
                                            border-color: Theme.border;
                                        }
                                    }
                                }

                                Rectangle {
                                    vertical-stretch: 1;
                                    background: transparent;
                                }

                                Text {
                                    text: root.status-text;
                                    color: Theme.muted;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        Text {
                            visible: !root.wide;
                            text: "android in a container, not an emulator";
                            color: Theme.muted;
                            font-size: 9px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    // The right column is the list, or the settings pane. The
                    // phone has the window in fullscreen, so it goes.
                    VerticalLayout {
                        visible: !root.wide;
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 10px;
                            height: 22px;

                            Text {
                                text: root.settings ? "settings" : "versions";
                                color: Theme.muted;
                                font-size: 10px;
                                vertical-alignment: center;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;

                                Rectangle {
                                    height: 1px;
                                    background: Theme.border;
                                }
                            }

                            Text {
                                visible: root.settings;
                                text: "esc";
                                color: Theme.muted;
                                font-size: 10px;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            visible: root.settings;
                            spacing: 6px;
                            height: 26px;

                            Tab {
                                label: "versions";
                                chosen: root.tab == 0;
                                pick => {
                                    root.tab = 0;
                                }
                            }
                            Tab {
                                label: "keys";
                                chosen: root.tab == 1;
                                pick => {
                                    root.tab = 1;
                                }
                            }
                            Tab {
                                label: "about";
                                chosen: root.tab == 2;
                                pick => {
                                    root.tab = 2;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                background: transparent;
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: transparent;
                            clip: true;

                            // The list: tap a row to select it, tap download to
                            // fetch it.
                            ListView {
                                visible: !root.settings;

                                for row[i] in root.rows : Rectangle {
                                    height: 66px;
                                    background: transparent;

                                    card := Rectangle {
                                        y: 3px;
                                        width: 100%;
                                        height: 60px;
                                        border-radius: Theme.radius * 1px;
                                        background: i == root.selected ? Theme.panel : Theme.key;
                                        border-width: 1px;
                                        border-color: i == root.selected ? Theme.accent : Theme.border;

                                        TouchArea {
                                            clicked => {
                                                root.selected = i;
                                            }
                                            mouse-cursor: pointer;
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 8px;
                                            spacing: 8px;

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                horizontal-stretch: 1;

                                                Text {
                                                    text: row.title;
                                                    color: row.live ? Theme.accent : Theme.fg;
                                                    font-size: 13px;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: row.subtitle;
                                                    color: Theme.muted;
                                                    font-size: 10px;
                                                    overflow: elide;
                                                }
                                            }

                                            // The state, on the right and readable,
                                            // and the one word that is a button.
                                            VerticalLayout {
                                                width: 96px;
                                                alignment: center;

                                                pill := Rectangle {
                                                    width: 100%;
                                                    height: 28px;
                                                    border-radius: Theme.radius * 1px;
                                                    background: row.download && pill-hit.has-hover ? Theme.panel : transparent;
                                                    border-width: row.download ? 1px : 0px;
                                                    border-color: row.live ? Theme.accent : Theme.border;

                                                    Text {
                                                        x: 0px;
                                                        width: parent.width - 8px;
                                                        text: row.state;
                                                        color: row.live ? Theme.accent : (row.download ? Theme.fg : Theme.muted);
                                                        font-size: 12px;
                                                        horizontal-alignment: right;
                                                        vertical-alignment: center;
                                                    }

                                                    pill-hit := TouchArea {
                                                        enabled: row.download;
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.selected = i;
                                                            root.install(row.id);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // The settings pane, in three tabs.
                            ScrollView {
                                visible: root.settings;
                                content-width: self.width;

                                VerticalLayout {
                                    width: 100%;
                                    spacing: 14px;

                                    if root.tab == 0 : VerticalLayout {
                                        spacing: 6px;

                                        Text {
                                            text: "the version android runs, and the ones it can run";
                                            color: Theme.muted;
                                            font-size: 10px;
                                            wrap: word-wrap;
                                        }

                                        for row[i] in root.rows : Rectangle {
                                            height: 44px;
                                            border-radius: Theme.radius * 1px;
                                            background: i == root.selected ? Theme.panel : transparent;
                                            border-width: 1px;
                                            border-color: i == root.selected ? Theme.accent : Theme.border;

                                            TouchArea {
                                                clicked => {
                                                    root.selected = i;
                                                }
                                                mouse-cursor: pointer;
                                            }

                                            HorizontalLayout {
                                                padding-left: 12px;
                                                padding-right: 12px;
                                                spacing: 8px;

                                                VerticalLayout {
                                                    alignment: center;
                                                    horizontal-stretch: 1;
                                                    spacing: 1px;

                                                    Text {
                                                        text: row.title;
                                                        color: row.live ? Theme.accent : Theme.fg;
                                                        font-size: 12px;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: row.subtitle;
                                                        color: Theme.muted;
                                                        font-size: 10px;
                                                        overflow: elide;
                                                    }
                                                }

                                                Text {
                                                    text: row.state;
                                                    color: row.live ? Theme.accent : Theme.muted;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    if root.tab == 1 : VerticalLayout {
                                        spacing: 2px;

                                        Text {
                                            text: "keys";
                                            color: Theme.muted;
                                            font-size: 10px;
                                        }
                                        KeyRow { k: "j / k"; v: "next / previous version"; }
                                        KeyRow { k: "space, s"; v: "start the selected version"; }
                                        KeyRow { k: "d"; v: "download it"; }
                                        KeyRow { k: "x"; v: "stop android"; }
                                        KeyRow { k: "o"; v: "bring the phone window back"; }
                                        KeyRow { k: "r"; v: "remove an installed version"; }
                                        KeyRow { k: "f"; v: "the phone on the whole screen"; }
                                        KeyRow { k: "R"; v: "refresh the catalog"; }
                                        KeyRow { k: ", ?"; v: "open and close these settings"; }
                                        KeyRow { k: "esc"; v: "close these settings"; }
                                        KeyRow { k: "q"; v: "quit omadroid"; }
                                    }

                                    if root.tab == 2 : VerticalLayout {
                                        spacing: 6px;

                                        Text {
                                            text: "omadroid " + root.app-version;
                                            color: Theme.fg;
                                            font-size: 12px;
                                        }
                                        Text {
                                            text: root.engine-text;
                                            color: Theme.muted;
                                            font-size: 10px;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "android runs in a container on this kernel, as Waydroid boots it: it is not emulated. switching a version rewrites Waydroid's images_path, so it is a restart, never a copy.";
                                            color: Theme.muted;
                                            font-size: 10px;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "the phone panel shows Android's own window, moved onto it by Hyprland. a Wayland app cannot host another one's surface, so this is as close as it gets.";
                                            color: Theme.muted;
                                            font-size: 10px;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "MIT · github.com/abraham-ukachi/omadroid";
                                            color: Theme.muted;
                                            font-size: 10px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // What went wrong, if anything
                Rectangle {
                    visible: root.notice != "";
                    height: root.notice == "" ? 0px : 30px;
                    background: Theme.key;

                    Text {
                        x: 20px;
                        width: parent.width - 40px;
                        height: parent.height;
                        text: root.notice;
                        color: Theme.accent;
                        font-size: 10px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // The download bar
                Rectangle {
                    visible: root.busy;
                    height: root.busy ? 2px : 0px;
                    background: Theme.border;

                    Rectangle {
                        width: parent.width * root.progress;
                        height: 2px;
                        background: Theme.accent;
                    }
                }

                // Key hints
                Rectangle {
                    visible: !root.wide;
                    height: 40px;
                    background: Theme.key;

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        spacing: 14px;
                        alignment: start;

                        Text {
                            text: "space start · d download · x stop";
                            color: Theme.muted;
                            font-size: 10px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: ", settings";
                            color: Theme.muted;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // First run: Waydroid is not on this machine yet.
        Rectangle {
            visible: root.needs-setup;
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            background: Theme.bg;

            VerticalLayout {
                padding: 32px;
                spacing: 12px;

                Text {
                    text: "omadroid";
                    color: Theme.fg;
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: "android is not installed on this machine yet";
                    color: Theme.accent;
                    font-size: 12px;
                }
                Text {
                    text: root.setup-detail;
                    color: Theme.fg;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                Text {
                    text: "one button: waydroid from the arch repositories, then the images waydroid downloads itself, about 1.6 GB. it needs root, so sudo or pkexec will ask.";
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                button := Rectangle {
                    width: 210px;
                    height: 40px;
                    border-radius: Theme.radius * 1px;
                    background: root.busy ? Theme.panel : (setup-hit.has-hover ? Theme.accent : Theme.fg);
                    border-width: 1px;
                    border-color: Theme.accent;

                    Text {
                        text: "install waydroid";
                        color: Theme.bg;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    setup-hit := TouchArea {
                        clicked => {
                            root.setup();
                        }
                        mouse-cursor: pointer;
                    }
                }

                Text {
                    text: root.status-text;
                    color: Theme.muted;
                    font-size: 10px;
                    wrap: word-wrap;
                }

                Rectangle {
                    visible: root.busy;
                    height: 2px;
                    background: Theme.border;

                    Rectangle {
                        width: parent.width * root.progress;
                        height: 2px;
                        background: Theme.accent;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: root.notice;
                    color: Theme.accent;
                    font-size: 10px;
                    wrap: word-wrap;
                }
            }
        }
    }

    // The panel's place in the window, for Hyprland. A timer, because nothing
    // tells us when the layout moved; 250 ms is far below what an eye notices.
    Timer {
        interval: 250ms;
        running: true;
        triggered => {
            root.phone-x = phone.absolute-position.x;
            root.phone-y = phone.absolute-position.y;
            root.phone-w = phone.width;
            root.phone-h = phone.height;
        }
    }
}
